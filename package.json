{
  "name": "holofx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The holofx superproject: hologpu, firetemple, watertemple and lighttemple, plus the site that teaches them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s4njee/holofx.git"
  },
  "homepage": "https://github.com/s4njee/holofx",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build:libs": "node scripts/build-libs.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "build:catalogue": "node scripts/build-catalogues.mjs && npm --prefix site run catalogue",
    "build:api": "node scripts/build-api.mjs",
    "build:site": "npm --prefix site run build",
    "build": "npm run build:libs && npm run build:labs && npm run build:catalogue && npm run build:api && npm run build:site",
    "catalogue": "npm --prefix site run catalogue",
    "dev": "npm --prefix site run dev",
    "check:links": "node scripts/check-links.mjs",
    "test:install": "node scripts/test-install.mjs",
    "previews": "node scripts/capture-previews.mjs",
    "publish:mk7s": "node scripts/publish-site-mk7s.mjs"
  }
}
